# Neon-managed (filled by `neon deploy` / `neon env pull` / `neon checkout`)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# On Vercel, AWS_* names are reserved. Set these instead (same values as above):
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_ENDPOINT_URL=
# STORAGE_REGION=
# STORAGE_BUCKET=product-images

# App config
NEON_AUTH_COOKIE_SECRET=   # openssl rand -base64 32
ADMIN_OWNER_EMAILS=        # comma-separated owner emails
