# Neon-managed (filled by `neon deploy` / `neon env pull` / `neon checkout`)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Object storage. Neon writes these as AWS_* — rename to STORAGE_* (Vercel rejects AWS_* names).
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT_URL=
STORAGE_REGION=
# STORAGE_BUCKET=product-images

# App config
NEON_AUTH_COOKIE_SECRET=   # openssl rand -base64 32
ADMIN_OWNER_EMAILS=        # comma-separated owner emails
